# MongoDB
MONGODB_URI=mongodb+srv://opengym_app:YOUR_REAL_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=opengym

# WebAuthn / Passkeys
# For local development:
# RP_ID=localhost
# ORIGIN=http://localhost:8080
#
# For production, these MUST match your deployed hostname.
# Example:
# RP_ID=gym.example.com
# ORIGIN=https://gym.example.com

RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=openGym

# Session security
# Generate a long random value for production.
SESSION_SECRET=replace-this-with-a-long-random-secret

# Push notifications / VAPID
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key

# Application settings
SESSION_DAYS=90

# Set to true if new accounts require invite codes.
INVITE_ONLY=false

# Optional comma-separated user IDs that should have admin access.
ADMIN_UIDS=